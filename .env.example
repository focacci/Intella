DATABASE_URL="file:./prisma/intella.db"
INTELLA_AUTH_TOKEN="dev-token"
INTELLA_FORCE_LOCAL="false"
INTELLA_FORCE_RULES="false"
INTELLA_LLM_UP="true"
INTELLA_PROVIDER_UP="true"
INTELLA_LAST_BACKUP_AT=""
INTELLA_LAST_SYNC_AT=""
INTELLA_LLM_SPEND_MTD="0"
INTELLA_LLM_MONTHLY_CEILING="10"
# Backups (T0.7 / R21). BACKUP_DIR defaults to ./backups; BACKUP_KEY is a base64
# 32-byte key (else a 0600 keyfile is generated); set BACKUP_OFFSITE to a synced
# path to silence the offsite warning. ENABLED starts the in-process scheduler.
INTELLA_BACKUP_DIR=""
INTELLA_BACKUP_KEY=""
INTELLA_BACKUP_OFFSITE=""
INTELLA_BACKUP_ENABLED="false"
INTELLA_BACKUP_HOUR="3"
VITE_INTELLA_API_BASE_URL="/api"
VITE_INTELLA_AUTH_TOKEN="dev-token"
API_HOST="127.0.0.1"
API_PORT="8787"

# Device pairing (T0.12 / R22). PUBLIC_BASE_URL is the address the phone dials —
# set it to your Tailscale Serve HTTPS name before running `setup` so the pairing
# QR points somewhere the phone can actually reach (see the deployment runbook).
# TTL_MINUTES is how long a pairing window stays open; DEVICE_NAME labels the
# token minted on pair.
INTELLA_PUBLIC_BASE_URL=""            # e.g. https://desktop.tailXXXX.ts.net
INTELLA_PAIRING_TTL_MINUTES="10"
INTELLA_PAIRING_DEVICE_NAME="Paired device"

# Docker deployment (T0.12). INTELLA_DATA_DIR is the HOST directory bind-mounted
# to /data in the containers (holds intella.db + /backups). Use an absolute path;
# recommended: your ~/Documents/Intella (expanded), e.g. /Users/you/Documents/Intella.
INTELLA_DATA_DIR="./data"
